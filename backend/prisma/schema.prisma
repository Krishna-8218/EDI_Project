// =============================================================================
// AssetFlow Enterprise Asset Management System - Prisma Schema
// PostgreSQL / Supabase
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  ROUTINE
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportType {
  DAMAGE
  LOSS
  ISSUE
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

// =============================================================================
// MODELS
// =============================================================================

/// System Users (Administrators, Department Managers, Employees)
model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  password     String     // Encrypted with bcrypt
  role         Role       @default(EMPLOYEE)
  department   String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  rfidCardId   String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  assignments  AssetAssignment[]
  reports      AssetReport[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
  @@index([department])
  @@index([status])
  @@map("users")
}

/// Central Asset Inventory
model Asset {
  id             String      @id @default(uuid()) @db.Uuid
  assetTag       String      @unique
  name           String
  category       String
  description    String?
  serialNumber   String?     @unique
  manufacturer   String?
  model          String?
  purchaseDate   DateTime?
  purchasePrice  Decimal?    @db.Decimal(12, 2)
  warrantyExpiry DateTime?
  status         AssetStatus @default(AVAILABLE)
  location       String?
  condition      String?     // e.g. "Excellent", "Good", "Fair", "Damaged"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relationships
  assignments    AssetAssignment[]
  maintenances   Maintenance[]
  reports        AssetReport[]
  healthPredictions AssetHealthPrediction[]

  @@index([assetTag])
  @@index([serialNumber])
  @@index([status])
  @@index([category])
  @@index([location])
  @@map("assets")
}

/// AI-Powered Asset Health & Risk Predictions
model AssetHealthPrediction {
  id              String   @id @default(uuid()) @db.Uuid
  assetId         String   @db.Uuid
  healthScore     Int
  status          String   // HEALTHY, MAINTENANCE_REQUIRED, REPLACE_SOON
  riskLevel       String   // LOW, MEDIUM, HIGH, CRITICAL
  probabilities   Json     // { HEALTHY: number, MAINTENANCE_REQUIRED: number, REPLACE_SOON: number }
  factors         Json     // Array of structured factors
  recommendations Json     // Array of actionable recommendations
  modelVersion    String   @default("1.0.0")
  predictedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  // Relationships
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@index([riskLevel])
  @@index([predictedAt])
  @@map("asset_health_predictions")
}

/// Asset Assignment History & Active Custody
model AssetAssignment {
  id         String           @id @default(uuid()) @db.Uuid
  assetId    String           @db.Uuid
  userId     String           @db.Uuid
  assignedAt DateTime         @default(now())
  returnedAt DateTime?
  notes      String?
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relationships
  asset      Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([userId])
  @@index([status])
  @@map("asset_assignments")
}

/// Maintenance and Servicing Records
model Maintenance {
  id              String            @id @default(uuid()) @db.Uuid
  assetId         String            @db.Uuid
  title           String
  description     String?
  maintenanceType MaintenanceType   @default(ROUTINE)
  scheduledDate   DateTime?
  completedDate   DateTime?
  cost            Decimal?          @db.Decimal(10, 2)
  status          MaintenanceStatus @default(SCHEDULED)
  performedBy     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  asset           Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@index([maintenanceType])
  @@map("maintenances")
}

/// Incident, Damage, and Loss Reports
model AssetReport {
  id          String       @id @default(uuid()) @db.Uuid
  assetId     String       @db.Uuid
  reportedBy  String       @db.Uuid
  type        ReportType
  description String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  // Relationships
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reporter    User         @relation(fields: [reportedBy], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([reportedBy])
  @@index([type])
  @@index([status])
  @@map("asset_reports")
}

/// Immutable Security and Operational Audit Trail
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  description String
  createdAt   DateTime @default(now())

  // Relationships
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
